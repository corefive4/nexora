:root {
  --n-bg: #080c14;
  --n-surface: #0e1521;
  --n-surface-2: #131c2b;
  --n-surface-3: #182334;

  --n-blue: #3d82f6;
  --n-blue-bright: #5b9bff;
  --n-blue-soft: rgba(61, 130, 246, 0.14);

  --n-lime: #b8f52a;
  --n-lime-soft: rgba(184, 245, 42, 0.12);

  --n-text: #e8edf5;
  --n-white: #f7f9fc;
  --n-muted: #8792a5;
  --n-dim: #5e6879;

  --n-green: #35d07f;
  --n-green-soft: rgba(53, 208, 127, 0.12);

  --n-red: #ff5c6c;
  --n-red-soft: rgba(255, 92, 108, 0.12);

  --n-yellow: #f6b73c;
  --n-yellow-soft: rgba(246, 183, 60, 0.12);

  --n-border: rgba(255, 255, 255, 0.07);
  --n-border-strong: rgba(255, 255, 255, 0.11);

  --n-radius-sm: 10px;
  --n-radius-md: 14px;
  --n-radius-lg: 18px;
  --n-radius-xl: 22px;
  --n-radius-pill: 999px;

  --n-shadow: 0 14px 40px rgba(0, 0, 0, 0.22);

  --n-ease: cubic-bezier(0.22, 1, 0.36, 1);

  color-scheme: dark;
}

* {
  box-sizing: border-box;
}

html {
  width: 100%;
  min-height: 100%;
  background: var(--n-bg);
  color: var(--n-text);
  color-scheme: dark;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

body {
  width: 100%;
  min-width: 0;
  min-height: 100vh;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  background:
    radial-gradient(
      circle at 50% -10%,
      rgba(61, 130, 246, 0.08),
      transparent 32rem
    ),
    var(--n-bg);
  color: var(--n-text);
  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Helvetica,
    Arial,
    sans-serif;
  font-size: 15px;
  line-height: 1.45;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  border: 0;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button:not(:disabled) {
  cursor: pointer;
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 2px solid var(--n-blue-bright);
  outline-offset: 2px;
}

a {
  color: inherit;
  text-decoration: none;
}

img,
svg {
  display: block;
}

svg {
  flex: 0 0 auto;
}

#root {
  width: 100%;
  min-height: 100vh;
}

.app-shell {
  position: relative;
  width: 100%;
  min-height: 100vh;
  min-height: 100dvh;
  padding-top: var(--tg-content-safe-area-inset-top, 0px);
  padding-left: var(--tg-content-safe-area-inset-left, 0px);
  padding-right: var(--tg-content-safe-area-inset-right, 0px);
}

.app-content {
  width: 100%;
  max-width: 760px;
  min-height: 100vh;
  min-height: 100dvh;
  margin: 0 auto;
  padding-bottom: calc(
    108px +
    var(--tg-content-safe-area-inset-bottom, 0px)
  );
}

.page {
  width: 100%;
  min-width: 0;
  padding: 20px 16px 0;
  animation: page-enter 320ms var(--n-ease);
}

@keyframes page-enter {
  from {
    opacity: 0;
    transform: translateY(6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.page-header {
  margin-bottom: 22px;
}

.page-header h1 {
  margin: 0;
  color: var(--n-white);
  font-size: 28px;
  font-weight: 760;
  letter-spacing: -0.035em;
  line-height: 1.08;
}

.page-header p {
  margin: 7px 0 0;
  color: var(--n-muted);
  font-size: 13px;
  line-height: 1.5;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 7px;
  color: var(--n-blue-bright);
  font-size: 11px;
  font-weight: 760;
  letter-spacing: 0.1em;
  line-height: 1.2;
  text-transform: uppercase;
}

.section {
  margin-top: 26px;
}

.section-title,
.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
  min-width: 0;
  margin-bottom: 12px;
}

.section-title-copy,
.section-heading > div {
  min-width: 0;
}

.section-title h2,
.section-heading h2 {
  margin: 0;
  color: var(--n-white);
  font-size: 17px;
  font-weight: 720;
  letter-spacing: -0.02em;
}

.section-title p,
.section-heading p {
  margin: 3px 0 0;
  color: var(--n-muted);
  font-size: 12px;
}

.section-title-action,
.text-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 3px;
  min-height: 36px;
  padding: 5px 0;
  background: transparent;
  color: var(--n-blue-bright);
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}

.section-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 25px;
  height: 24px;
  padding: 0 7px;
  border: 1px solid var(--n-border);
  border-radius: var(--n-radius-pill);
  background: var(--n-surface);
  color: var(--n-muted);
  font-size: 11px;
  font-weight: 700;
}

.card {
  min-width: 0;
  border: 1px solid var(--n-border);
  border-radius: var(--n-radius-lg);
  background: var(--n-surface);
  box-shadow: var(--n-shadow);
}

.card-soft {
  border: 1px solid var(--n-border);
  border-radius: var(--n-radius-lg);
  background: rgba(14, 21, 33, 0.74);
}

.positive {
  color: var(--n-green) !important;
}

.muted {
  color: var(--n-muted);
}

.feature-icon,
.stat-card-icon,
.menu-item-icon,
.security-icon,
.account-security-icon,
.earn-task-icon,
.earn-how-icon,
.friends-network-icon,
.plan-icon,
.invest-plan-option-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 13px;
}

.feature-icon {
  width: 42px;
  height: 42px;
}

.feature-icon-blue,
.stat-card-icon,
.menu-item-icon {
  background: var(--n-blue-soft);
  color: var(--n-blue-bright);
}

.feature-icon-lime {
  background: var(--n-lime-soft);
  color: var(--n-lime);
}

.feature-icon-green {
  background: var(--n-green-soft);
  color: var(--n-green);
}

.feature-icon-neutral {
  background: rgba(255, 255, 255, 0.055);
  color: var(--n-muted);
}

.balance-card {
  position: relative;
  min-width: 0;
  overflow: hidden;
  padding: 20px;
  border: 1px solid rgba(61, 130, 246, 0.22);
  border-radius: var(--n-radius-xl);
  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(61, 130, 246, 0.18),
      transparent 48%
    ),
    linear-gradient(145deg, #101a2a 0%, #0d1522 100%);
  box-shadow: var(--n-shadow);
}

.balance-card::after {
  position: absolute;
  right: -45px;
  bottom: -55px;
  width: 150px;
  height: 150px;
  border: 1px solid rgba(184, 245, 42, 0.08);
  border-radius: 50%;
  content: "";
  pointer-events: none;
}

.balance-card-header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.balance-card-label {
  display: block;
  margin-bottom: 5px;
  color: var(--n-muted);
  font-size: 12px;
  font-weight: 620;
}

.balance-card-value {
  color: var(--n-white);
  font-size: clamp(29px, 8vw, 40px);
  font-weight: 790;
  letter-spacing: -0.045em;
  line-height: 1.04;
}

.balance-card-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border: 1px solid rgba(61, 130, 246, 0.2);
  border-radius: 13px;
  background: var(--n-blue-soft);
  color: var(--n-blue-bright);
}

.balance-card-meta {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-top: 22px;
  padding-top: 15px;
  border-top: 1px solid var(--n-border);
}

.balance-card-meta > div {
  min-width: 0;
}

.balance-card-meta span,
.balance-card-meta strong {
  display: block;
}

.balance-card-meta span {
  margin-bottom: 4px;
  color: var(--n-dim);
  font-size: 10px;
  font-weight: 620;
}

.balance-card-meta strong {
  overflow: hidden;
  color: var(--n-text);
  font-size: 12px;
  font-weight: 720;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.balance-card-compact {
  padding: 16px;
}

.balance-card-compact .balance-card-value {
  font-size: 26px;
}

.stat-card {
  min-width: 0;
  min-height: 122px;
  padding: 15px;
  border: 1px solid var(--n-border);
  border-radius: var(--n-radius-lg);
  background: var(--n-surface);
}

.stat-card-icon {
  width: 34px;
  height: 34px;
  margin-bottom: 13px;
}

.stat-card-lime .stat-card-icon {
  background: var(--n-lime-soft);
  color: var(--n-lime);
}

.stat-card-green .stat-card-icon {
  background: var(--n-green-soft);
  color: var(--n-green);
}

.stat-card-neutral .stat-card-icon {
  background: rgba(255, 255, 255, 0.055);
  color: var(--n-muted);
}

.stat-card-label {
  overflow: hidden;
  margin-bottom: 4px;
  color: var(--n-muted);
  font-size: 11px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-card-value {
  overflow: hidden;
  color: var(--n-white);
  font-size: 17px;
  font-weight: 760;
  letter-spacing: -0.02em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-card-caption {
  margin-top: 3px;
  color: var(--n-dim);
  font-size: 10px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 46px;
  padding: 0 17px;
  border: 1px solid transparent;
  border-radius: 13px;
  font-size: 13px;
  font-weight: 740;
  line-height: 1;
  transition:
    transform 180ms var(--n-ease),
    opacity 180ms ease,
    background 180ms ease,
    border-color 180ms ease;
}

.button:active {
  transform: scale(0.98);
}

.button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.button-primary {
  background: var(--n-blue);
  color: #fff;
  box-shadow: 0 8px 22px rgba(61, 130, 246, 0.2);
}

.button-primary:hover:not(:disabled) {
  background: var(--n-blue-bright);
}

.button-secondary {
  border-color: var(--n-border-strong);
  background: rgba(255, 255, 255, 0.045);
  color: var(--n-text);
}

.button-secondary:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.075);
}

.button-lime {
  background: var(--n-lime);
  color: #101508;
}

.button-full {
  width: 100%;
}

.button-small {
  min-height: 38px;
  padding: 0 13px;
  border-radius: 11px;
  font-size: 12px;
}

.plan-rate {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.plan-rate strong {
  color: var(--n-lime);
  font-size: 22px;
  font-weight: 790;
  letter-spacing: -0.04em;
}

.plan-rate span {
  color: var(--n-muted);
  font-size: 10px;
}

.calculation-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  min-height: 38px;
  color: var(--n-muted);
  font-size: 12px;
}

.calculation-row strong {
  color: var(--n-text);
  font-weight: 700;
  text-align: right;
}

.calculation-row-strong {
  margin-top: 5px;
  padding-top: 12px;
  border-top: 1px solid var(--n-border);
  color: var(--n-text);
}

.calculation-row-strong strong {
  color: var(--n-white);
  font-size: 16px;
}

.menu-list {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--n-border);
  border-radius: var(--n-radius-lg);
  background: var(--n-surface);
}

.menu-item {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 67px;
  gap: 12px;
  padding: 10px 13px;
  border-bottom: 1px solid var(--n-border);
  background: transparent;
  color: var(--n-text);
  text-align: left;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-item:not(:disabled):active {
  background: rgba(255, 255, 255, 0.035);
}

.menu-item-icon {
  width: 38px;
  height: 38px;
  border-radius: 11px;
}

.menu-item-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 2px;
}

.menu-item-copy strong {
  color: var(--n-text);
  font-size: 13px;
  font-weight: 680;
}

.menu-item-copy small {
  overflow: hidden;
  color: var(--n-muted);
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-item-badge {
  padding: 4px 7px;
  border-radius: var(--n-radius-pill);
  background: var(--n-lime-soft);
  color: var(--n-lime);
  font-size: 9px;
  font-weight: 750;
}

.menu-item-arrow {
  color: var(--n-dim);
}

.empty-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 28px 18px;
  border: 1px dashed var(--n-border-strong);
  border-radius: var(--n-radius-lg);
  background: rgba(255, 255, 255, 0.018);
  text-align: center;
}

.empty-state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 46px;
  margin-bottom: 12px;
  border-radius: 14px;
  background: var(--n-blue-soft);
  color: var(--n-blue-bright);
}

.empty-state h3 {
  margin: 0;
  color: var(--n-text);
  font-size: 14px;
}

.empty-state p {
  max-width: 300px;
  margin: 5px 0 0;
  color: var(--n-muted);
  font-size: 11px;
  line-height: 1.55;
}

.empty-state-action {
  margin-top: 15px;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  min-height: 25px;
  padding: 0 8px;
  border-radius: var(--n-radius-pill);
  font-size: 10px;
  font-weight: 720;
}

.status-active {
  background: var(--n-green-soft);
  color: var(--n-green);
}

.status-completed {
  background: var(--n-blue-soft);
  color: var(--n-blue-bright);
}

.status-cancelled {
  background: var(--n-red-soft);
  color: var(--n-red);
}

.status-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: currentColor;
}

.home-page {
  padding-top: 16px;
}

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.home-header-copy {
  min-width: 0;
}

.home-header-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border: 1px solid rgba(184, 245, 42, 0.18);
  border-radius: 14px;
  background: var(--n-lime-soft);
  color: var(--n-lime);
  font-size: 17px;
  font-weight: 850;
}

.home-greeting {
  margin: 0;
  color: var(--n-muted);
  font-size: 11px;
  font-weight: 620;
}

.home-title {
  margin: 2px 0 0;
  color: var(--n-white);
  font-size: 25px;
  font-weight: 790;
  letter-spacing: -0.035em;
}

.home-balance-card {
  margin-top: 0;
}

.home-balance-actions {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
  margin-top: 18px;
}

.home-balance-actions .button {
  min-height: 42px;
}

.home-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9px;
}

.home-stats-grid .stat-card {
  min-height: 105px;
}

.portfolio-card {
  padding: 16px;
  border: 1px solid var(--n-border);
  border-radius: var(--n-radius-lg);
  background: var(--n-surface);
}

.portfolio-chart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 8px;
}

.portfolio-chart-title {
  color: var(--n-text);
  font-size: 12px;
  font-weight: 700;
}

.portfolio-chart-caption {
  color: var(--n-muted);
  font-size: 10px;
}

.portfolio-chart {
  width: 100%;
  height: 150px;
  overflow: hidden;
}

.portfolio-chart svg {
  width: 100%;
  height: 100%;
}

.allocation-row {
  margin-top: 15px;
}

.allocation-labels {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 7px;
  color: var(--n-muted);
  font-size: 10px;
}

.allocation-bar {
  display: flex;
  width: 100%;
  height: 7px;
  overflow: hidden;
  border-radius: 99px;
  background: rgba(255, 255, 255, 0.06);
}

.allocation-bar > span {
  height: 100%;
}

.allocation-available {
  background: var(--n-blue);
}

.allocation-invested {
  background: var(--n-lime);
}

.featured-plan-card {
  position: relative;
  overflow: hidden;
  padding: 17px;
  border: 1px solid rgba(184, 245, 42, 0.16);
  border-radius: var(--n-radius-lg);
  background:
    radial-gradient(
      circle at 100% 0,
      rgba(184, 245, 42, 0.09),
      transparent 42%
    ),
    var(--n-surface);
}

.featured-plan-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
}

.featured-plan-main {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 11px;
}

.featured-plan-title {
  margin: 0;
  color: var(--n-white);
  font-size: 15px;
  font-weight: 730;
}

.plan-details {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 7px;
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid var(--n-border);
}

.plan-detail {
  min-width: 0;
}

.plan-detail span,
.plan-detail strong {
  display: block;
}

.plan-detail span {
  margin-bottom: 3px;
  color: var(--n-dim);
  font-size: 9px;
}

.plan-detail strong {
  overflow: hidden;
  color: var(--n-text);
  font-size: 11px;
  font-weight: 680;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.investment-list,
.activity-list {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--n-border);
  border-radius: var(--n-radius-lg);
  background: var(--n-surface);
}

.investment-card,
.activity-row {
  border-bottom: 1px solid var(--n-border);
}

.investment-card:last-child,
.activity-row:last-child {
  border-bottom: 0;
}

.investment-card {
  padding: 15px;
}

.investment-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.investment-card-name {
  color: var(--n-text);
  font-size: 13px;
  font-weight: 700;
}

.investment-card-amount {
  margin-top: 3px;
  color: var(--n-white);
  font-size: 18px;
  font-weight: 770;
  letter-spacing: -0.025em;
}

.investment-progress {
  height: 6px;
  margin-top: 13px;
  overflow: hidden;
  border-radius: 99px;
  background: rgba(255, 255, 255, 0.06);
}

.investment-progress > span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: var(--n-blue);
}

.investment-date {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin-top: 7px;
  color: var(--n-muted);
  font-size: 9px;
}

.activity-row {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 13px 14px;
}

.activity-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  flex: 0 0 auto;
  border-radius: 11px;
}

.activity-deposit {
  background: var(--n-blue-soft);
  color: var(--n-blue-bright);
}

.activity-investment {
  background: var(--n-lime-soft);
  color: var(--n-lime);
}

.activity-earning {
  background: var(--n-green-soft);
  color: var(--n-green);
}

.activity-withdrawal {
  background: var(--n-red-soft);
  color: var(--n-red);
}

.activity-copy {
  min-width: 0;
  flex: 1;
}

.activity-copy strong,
.activity-copy span {
  display: block;
}

.activity-copy strong {
  overflow: hidden;
  color: var(--n-text);
  font-size: 12px;
  font-weight: 660;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-copy span {
  margin-top: 2px;
  color: var(--n-dim);
  font-size: 9px;
}

.activity-amount {
  flex: 0 0 auto;
  color: var(--n-text);
  font-size: 12px;
  font-weight: 720;
}


/* =========================================================
   INVEST PAGE
   ========================================================= */

.invest-page {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.invest-hero {
  position: relative;
  overflow: hidden;
  padding: 20px;
  border: 1px solid var(--n-border);
  border-radius: 24px;
  background:
    radial-gradient(circle at 90% 0%, rgba(61, 130, 246, 0.18), transparent 42%),
    linear-gradient(145deg, #151d2c, #111722);
}

.invest-hero::after {
  content: "";
  position: absolute;
  width: 150px;
  height: 150px;
  right: -70px;
  bottom: -80px;
  border-radius: 999px;
  background: rgba(184, 245, 42, 0.07);
  pointer-events: none;
}

.invest-hero-content {
  position: relative;
  z-index: 1;
}

.invest-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 8px;
  color: var(--n-lime);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.invest-title {
  margin: 0;
  color: var(--n-text);
  font-size: clamp(24px, 7vw, 32px);
  font-weight: 820;
  letter-spacing: -0.04em;
  line-height: 1.05;
}

.invest-subtitle {
  max-width: 440px;
  margin: 9px 0 0;
  color: var(--n-muted);
  font-size: 12px;
  line-height: 1.55;
}

.invest-balance-strip {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-top: 18px;
}

.invest-balance-item {
  padding: 11px 12px;
  border: 1px solid var(--n-border);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.025);
}

.invest-balance-label {
  color: var(--n-muted);
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.invest-balance-value {
  margin-top: 4px;
  color: var(--n-text);
  font-size: 15px;
  font-weight: 800;
}

.plan-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.plan-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 15px;
  border: 1px solid var(--n-border);
  border-radius: 20px;
  background: var(--n-card);
  cursor: pointer;
  transition:
    border-color 180ms ease,
    transform 180ms ease,
    background 180ms ease;
}

.plan-card:hover {
  transform: translateY(-1px);
}

.plan-card.selected {
  border-color: rgba(61, 130, 246, 0.7);
  background:
    linear-gradient(
      145deg,
      rgba(61, 130, 246, 0.13),
      rgba(21, 27, 39, 0.98)
    );
  box-shadow: 0 0 0 1px rgba(61, 130, 246, 0.12);
}

.plan-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
}

.plan-card-name {
  color: var(--n-text);
  font-size: 13px;
  font-weight: 800;
}

.plan-card-check {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 21px;
  height: 21px;
  flex: 0 0 auto;
  border: 1px solid var(--n-border);
  border-radius: 999px;
  color: transparent;
}

.plan-card.selected .plan-card-check {
  border-color: var(--n-blue);
  background: var(--n-blue);
  color: #fff;
}

.plan-card-rate {
  margin-top: 14px;
  color: var(--n-lime);
  font-size: 24px;
  font-weight: 850;
  letter-spacing: -0.04em;
}

.plan-card-rate-label {
  margin-top: 2px;
  color: var(--n-muted);
  font-size: 9px;
}

.plan-card-range {
  margin-top: 12px;
  color: var(--n-text-soft);
  font-size: 10px;
  font-weight: 650;
}

.plan-card-duration {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-top: 7px;
  color: var(--n-muted);
  font-size: 10px;
}

.plan-featured {
  position: absolute;
  top: 10px;
  left: 10px;
  padding: 3px 7px;
  border-radius: 999px;
  background: rgba(184, 245, 42, 0.12);
  color: var(--n-lime);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.invest-form-card {
  padding: 18px;
  border: 1px solid var(--n-border);
  border-radius: 22px;
  background: var(--n-card);
}

.invest-form-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.invest-form-title {
  margin: 0;
  color: var(--n-text);
  font-size: 16px;
  font-weight: 800;
}

.invest-form-caption {
  margin: 4px 0 0;
  color: var(--n-muted);
  font-size: 10px;
}

.invest-selected-rate {
  color: var(--n-lime);
  font-size: 16px;
  font-weight: 850;
  white-space: nowrap;
}

.amount-field {
  margin-top: 18px;
}

.amount-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 7px;
}

.amount-label {
  color: var(--n-text-soft);
  font-size: 10px;
  font-weight: 750;
}

.amount-balance {
  color: var(--n-muted);
  font-size: 9px;
}

.amount-input-wrap {
  position: relative;
}

.amount-input-symbol {
  position: absolute;
  top: 50%;
  left: 15px;
  transform: translateY(-50%);
  color: var(--n-muted);
  font-size: 15px;
  font-weight: 800;
  pointer-events: none;
}

.amount-input {
  width: 100%;
  min-height: 52px;
  padding: 0 15px 0 32px;
  border: 1px solid var(--n-border);
  border-radius: 15px;
  outline: none;
  background: #101620;
  color: var(--n-text);
  font-size: 19px;
  font-weight: 800;
  transition:
    border-color 160ms ease,
    box-shadow 160ms ease;
}

.amount-input:focus {
  border-color: rgba(61, 130, 246, 0.8);
  box-shadow: 0 0 0 3px rgba(61, 130, 246, 0.11);
}

.amount-input::placeholder {
  color: #4c5667;
}

.amount-shortcuts {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 9px;
}

.amount-shortcut {
  min-height: 32px;
  padding: 0 11px;
  border: 1px solid var(--n-border);
  border-radius: 10px;
  background: #101620;
  color: var(--n-text-soft);
  font-size: 9px;
  font-weight: 750;
  cursor: pointer;
}

.amount-shortcut:hover {
  border-color: rgba(61, 130, 246, 0.5);
  color: var(--n-text);
}

.calculation-card {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-top: 15px;
  overflow: hidden;
  border: 1px solid var(--n-border);
  border-radius: 16px;
  background: #101620;
}

.calculation-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  min-height: 40px;
  padding: 0 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.045);
}

.calculation-row:last-child {
  border-bottom: 0;
}

.calculation-label {
  color: var(--n-muted);
  font-size: 10px;
}

.calculation-value {
  color: var(--n-text);
  font-size: 11px;
  font-weight: 750;
  text-align: right;
}

.calculation-value.profit {
  color: var(--n-lime);
}

.calculation-value.total {
  color: var(--n-blue-soft);
  font-size: 13px;
}

.invest-validation {
  display: flex;
  align-items: flex-start;
  gap: 7px;
  margin-top: 12px;
  padding: 10px 11px;
  border-radius: 12px;
  background: rgba(255, 181, 71, 0.08);
  color: #f1c27d;
  font-size: 10px;
  line-height: 1.45;
}

.invest-validation.success {
  background: rgba(184, 245, 42, 0.07);
  color: var(--n-lime);
}

.invest-confirm-button {
  width: 100%;
  min-height: 50px;
  margin-top: 13px;
  border: 0;
  border-radius: 15px;
  background: linear-gradient(135deg, var(--n-blue), #5a94f5);
  color: #fff;
  font-size: 12px;
  font-weight: 820;
  cursor: pointer;
  box-shadow: 0 10px 24px rgba(61, 130, 246, 0.18);
  transition:
    transform 160ms ease,
    opacity 160ms ease;
}

.invest-confirm-button:hover {
  transform: translateY(-1px);
}

.invest-confirm-button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

.invest-note {
  margin-top: 10px;
  color: var(--n-muted);
  font-size: 9px;
  line-height: 1.45;
  text-align: center;
}

.active-investments {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.investment-row {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 0;
  padding: 13px;
  border: 1px solid var(--n-border);
  border-radius: 17px;
  background: var(--n-card);
}

.investment-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  flex: 0 0 auto;
  border-radius: 13px;
  background: rgba(61, 130, 246, 0.1);
  color: var(--n-blue-soft);
}

.investment-main {
  min-width: 0;
  flex: 1;
}

.investment-name {
  overflow: hidden;
  color: var(--n-text);
  font-size: 11px;
  font-weight: 760;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.investment-meta {
  margin-top: 4px;
  color: var(--n-muted);
  font-size: 9px;
}

.investment-amount {
  flex: 0 0 auto;
  color: var(--n-text);
  font-size: 12px;
  font-weight: 800;
  text-align: right;
}

.investment-return {
  margin-top: 3px;
  color: var(--n-lime);
  font-size: 9px;
  font-weight: 700;
  text-align: right;
}

/* =========================================================
   EARN PAGE
   ========================================================= */

.earn-page {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.earn-hero {
  position: relative;
  overflow: hidden;
  padding: 20px;
  border: 1px solid rgba(184, 245, 42, 0.16);
  border-radius: 24px;
  background:
    radial-gradient(circle at 85% 20%, rgba(184, 245, 42, 0.12), transparent 35%),
    linear-gradient(145deg, #172019, #111722);
}

.earn-hero::before {
  content: "";
  position: absolute;
  width: 190px;
  height: 190px;
  right: -110px;
  top: -110px;
  border: 1px solid rgba(184, 245, 42, 0.12);
  border-radius: 999px;
}

.earn-hero-content {
  position: relative;
  z-index: 1;
}

.earn-icon-large {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  margin-bottom: 14px;
  border: 1px solid rgba(184, 245, 42, 0.18);
  border-radius: 15px;
  background: rgba(184, 245, 42, 0.09);
  color: var(--n-lime);
}

.earn-title {
  margin: 0;
  color: var(--n-text);
  font-size: 25px;
  font-weight: 820;
  letter-spacing: -0.04em;
}

.earn-subtitle {
  max-width: 420px;
  margin: 8px 0 0;
  color: var(--n-muted);
  font-size: 11px;
  line-height: 1.5;
}

.earn-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
  margin-top: 17px;
}

.earn-summary-card {
  padding: 11px;
  border: 1px solid var(--n-border);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.025);
}

.earn-summary-value {
  color: var(--n-text);
  font-size: 15px;
  font-weight: 820;
}

.earn-summary-label {
  margin-top: 3px;
  color: var(--n-muted);
  font-size: 8px;
  line-height: 1.25;
}

.earn-task-list {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.earn-task {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
  padding: 13px;
  border: 1px solid var(--n-border);
  border-radius: 18px;
  background: var(--n-card);
}

.earn-task-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  flex: 0 0 auto;
  border-radius: 13px;
  background: rgba(61, 130, 246, 0.09);
  color: var(--n-blue-soft);
}

.earn-task-main {
  min-width: 0;
  flex: 1;
}

.earn-task-title {
  overflow: hidden;
  color: var(--n-text);
  font-size: 11px;
  font-weight: 780;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.earn-task-description {
  margin-top: 4px;
  color: var(--n-muted);
  font-size: 9px;
  line-height: 1.4;
}

.earn-task-reward {
  margin-top: 5px;
  color: var(--n-lime);
  font-size: 10px;
  font-weight: 800;
}

.earn-task-action {
  flex: 0 0 auto;
  min-width: 68px;
  min-height: 34px;
  padding: 0 10px;
  border: 1px solid rgba(61, 130, 246, 0.35);
  border-radius: 10px;
  background: rgba(61, 130, 246, 0.08);
  color: var(--n-blue-soft);
  font-size: 9px;
  font-weight: 800;
  cursor: pointer;
}

.earn-task-action:hover {
  background: rgba(61, 130, 246, 0.14);
}

.earn-task-action.claimed {
  border-color: rgba(184, 245, 42, 0.25);
  background: rgba(184, 245, 42, 0.07);
  color: var(--n-lime);
  cursor: default;
}

.earn-task-action:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.earn-how-card {
  padding: 17px;
  border: 1px solid var(--n-border);
  border-radius: 20px;
  background: var(--n-card);
}

.earn-how-list {
  display: flex;
  flex-direction: column;
  gap: 13px;
  margin-top: 13px;
}

.earn-how-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.earn-how-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 23px;
  height: 23px;
  flex: 0 0 auto;
  border-radius: 8px;
  background: rgba(184, 245, 42, 0.09);
  color: var(--n-lime);
  font-size: 9px;
  font-weight: 850;
}

.earn-how-title {
  color: var(--n-text);
  font-size: 10px;
  font-weight: 750;
}

.earn-how-text {
  margin-top: 3px;
  color: var(--n-muted);
  font-size: 9px;
  line-height: 1.4;
}

/* =========================================================
   FRIENDS PAGE
   ========================================================= */

.friends-page {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.friends-hero {
  position: relative;
  overflow: hidden;
  padding: 20px;
  border: 1px solid rgba(61, 130, 246, 0.2);
  border-radius: 24px;
  background:
    radial-gradient(circle at 88% 15%, rgba(61, 130, 246, 0.2), transparent 38%),
    linear-gradient(145deg, #141d2d, #111722);
}

.friends-hero-content {
  position: relative;
  z-index: 1;
}

.friends-icon-large {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  margin-bottom: 14px;
  border-radius: 15px;
  background: rgba(61, 130, 246, 0.1);
  color: var(--n-blue-soft);
}

.friends-title {
  margin: 0;
  color: var(--n-text);
  font-size: 25px;
  font-weight: 820;
  letter-spacing: -0.04em;
}

.friends-subtitle {
  max-width: 430px;
  margin: 8px 0 0;
  color: var(--n-muted);
  font-size: 11px;
  line-height: 1.5;
}

.referral-link-card {
  margin-top: 17px;
  padding: 12px;
  border: 1px solid var(--n-border);
  border-radius: 15px;
  background: rgba(0, 0, 0, 0.13);
}

.referral-link-label {
  color: var(--n-muted);
  font-size: 8px;
  font-weight: 750;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.referral-link-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 7px;
}

.referral-link {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: var(--n-text-soft);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 9px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.referral-copy-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  border: 1px solid var(--n-border);
  border-radius: 10px;
  background: #101620;
  color: var(--n-blue-soft);
  cursor: pointer;
}

.referral-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-top: 9px;
}

.referral-action-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 39px;
  border: 1px solid var(--n-border);
  border-radius: 12px;
  background: #101620;
  color: var(--n-text-soft);
  font-size: 10px;
  font-weight: 750;
  cursor: pointer;
}

.referral-action-button.primary {
  border-color: rgba(61, 130, 246, 0.35);
  background: rgba(61, 130, 246, 0.1);
  color: var(--n-blue-soft);
}

.referral-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
}

.referral-stat {
  padding: 14px;
  border: 1px solid var(--n-border);
  border-radius: 17px;
  background: var(--n-card);
}

.referral-stat-value {
  color: var(--n-text);
  font-size: 20px;
  font-weight: 820;
  letter-spacing: -0.03em;
}

.referral-stat-value.lime {
  color: var(--n-lime);
}

.referral-stat-label {
  margin-top: 4px;
  color: var(--n-muted);
  font-size: 9px;
}

.referral-level-list {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.referral-level {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
  padding: 13px;
  border: 1px solid var(--n-border);
  border-radius: 17px;
  background: var(--n-card);
}

.referral-level-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  flex: 0 0 auto;
  border-radius: 12px;
  background: rgba(61, 130, 246, 0.09);
  color: var(--n-blue-soft);
  font-size: 12px;
  font-weight: 850;
}

.referral-level-main {
  min-width: 0;
  flex: 1;
}

.referral-level-title {
  color: var(--n-text);
  font-size: 11px;
  font-weight: 780;
}

.referral-level-members {
  margin-top: 3px;
  color: var(--n-muted);
  font-size: 9px;
}

.referral-level-rate {
  color: var(--n-lime);
  font-size: 16px;
  font-weight: 850;
}

.referral-network-card {
  padding: 17px;
  border: 1px solid var(--n-border);
  border-radius: 20px;
  background: var(--n-card);
}

.referral-network-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
  margin-top: 13px;
}

.referral-network-item {
  padding: 11px;
  border-radius: 13px;
  background: #101620;
  text-align: center;
}

.referral-network-value {
  color: var(--n-text);
  font-size: 16px;
  font-weight: 820;
}

.referral-network-label {
  margin-top: 3px;
  color: var(--n-muted);
  font-size: 8px;
}

/* =========================================================
   ACCOUNT PAGE
   ========================================================= */

.account-page {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.account-profile {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 17px;
  border: 1px solid var(--n-border);
  border-radius: 21px;
  background:
    radial-gradient(circle at 90% 0%, rgba(61, 130, 246, 0.11), transparent 35%),
    var(--n-card);
}

.account-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  flex: 0 0 auto;
  overflow: hidden;
  border: 1px solid rgba(61, 130, 246, 0.25);
  border-radius: 16px;
  background: rgba(61, 130, 246, 0.1);
  color: var(--n-blue-soft);
  font-size: 18px;
  font-weight: 850;
}

.account-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.account-profile-main {
  min-width: 0;
  flex: 1;
}

.account-name {
  overflow: hidden;
  color: var(--n-text);
  font-size: 15px;
  font-weight: 820;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-username {
  margin-top: 4px;
  overflow: hidden;
  color: var(--n-muted);
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-verified {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: 7px;
  color: var(--n-lime);
  font-size: 8px;
  font-weight: 750;
}

.account-summary {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
}

.account-summary-card {
  padding: 14px;
  border: 1px solid var(--n-border);
  border-radius: 17px;
  background: var(--n-card);
}

.account-summary-label {
  color: var(--n-muted);
  font-size: 9px;
}

.account-summary-value {
  margin-top: 5px;
  color: var(--n-text);
  font-size: 17px;
  font-weight: 820;
  letter-spacing: -0.03em;
}

.account-summary-value.lime {
  color: var(--n-lime);
}

.account-menu {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--n-border);
  border-radius: 20px;
  background: var(--n-card);
}

.account-menu-item {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 63px;
  padding: 0 14px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.045);
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.account-menu-item:last-child {
  border-bottom: 0;
}

.account-menu-item:hover {
  background: rgba(255, 255, 255, 0.018);
}

.account-menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  flex: 0 0 auto;
  border-radius: 11px;
  background: rgba(61, 130, 246, 0.08);
  color: var(--n-blue-soft);
}

.account-menu-main {
  min-width: 0;
  flex: 1;
}

.account-menu-title {
  color: var(--n-text);
  font-size: 11px;
  font-weight: 760;
}

.account-menu-description {
  margin-top: 3px;
  color: var(--n-muted);
  font-size: 8px;
  line-height: 1.35;
}

.account-security {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 14px;
  border: 1px solid rgba(184, 245, 42, 0.12);
  border-radius: 18px;
  background: rgba(184, 245, 42, 0.035);
}

.account-security-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  border-radius: 10px;
  background: rgba(184, 245, 42, 0.08);
  color: var(--n-lime);
}

.account-security-title {
  color: var(--n-text);
  font-size: 10px;
  font-weight: 780;
}

.account-security-text {
  margin-top: 3px;
  color: var(--n-muted);
  font-size: 8px;
  line-height: 1.45;
}

.account-footer {
  padding: 4px 4px 10px;
  color: #4f5969;
  font-size: 8px;
  line-height: 1.5;
  text-align: center;
}

/* =========================================================
   BOTTOM NAVIGATION
   ========================================================= */

.bottom-nav {
  position: fixed;
  z-index: 40;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: stretch;
  justify-content: center;
  padding:
    7px
    max(10px, env(safe-area-inset-left))
    calc(7px + env(safe-area-inset-bottom))
    max(10px, env(safe-area-inset-right));
  border-top: 1px solid rgba(255, 255, 255, 0.07);
  background: rgba(13, 17, 26, 0.94);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.bottom-nav-inner {
  display: grid;
  width: min(100%, 560px);
  grid-template-columns: repeat(5, 1fr);
  gap: 4px;
}

.bottom-nav-item {
  position: relative;
  display: flex;
  min-width: 0;
  min-height: 51px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  border: 0;
  border-radius: 13px;
  background: transparent;
  color: #697385;
  cursor: pointer;
  transition:
    color 160ms ease,
    background 160ms ease;
}

.bottom-nav-item.active {
  background: rgba(61, 130, 246, 0.1);
  color: var(--n-blue-soft);
}

.bottom-nav-item.active::before {
  content: "";
  position: absolute;
  top: -7px;
  width: 20px;
  height: 2px;
  border-radius: 999px;
  background: var(--n-blue);
}

.bottom-nav-label {
  overflow: hidden;
  max-width: 100%;
  font-size: 8px;
  font-weight: 720;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* =========================================================
   DEPOSIT MODAL
   ========================================================= */

.modal-backdrop {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 14px;
  background: rgba(3, 6, 11, 0.74);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

.modal {
  width: min(100%, 480px);
  max-height: min(86vh, 720px);
  overflow: auto;
  border: 1px solid var(--n-border);
  border-radius: 25px 25px 18px 18px;
  background: #111722;
  box-shadow: 0 -20px 70px rgba(0, 0, 0, 0.4);
  animation: nexora-modal-in 180ms ease-out;
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 18px 18px 0;
}

.modal-title {
  margin: 0;
  color: var(--n-text);
  font-size: 18px;
  font-weight: 820;
  letter-spacing: -0.025em;
}

.modal-description {
  margin: 5px 0 0;
  color: var(--n-muted);
  font-size: 10px;
  line-height: 1.45;
}

.modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  border: 1px solid var(--n-border);
  border-radius: 11px;
  background: #151c28;
  color: var(--n-muted);
  cursor: pointer;
}

.modal-body {
  padding: 16px 18px 20px;
}

.deposit-address-card {
  padding: 14px;
  border: 1px solid rgba(61, 130, 246, 0.18);
  border-radius: 17px;
  background: rgba(61, 130, 246, 0.05);
}

.deposit-address-label {
  color: var(--n-muted);
  font-size: 8px;
  font-weight: 750;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.deposit-address {
  margin-top: 8px;
  overflow-wrap: anywhere;
  color: var(--n-text);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.5;
}

.deposit-copy-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 38px;
  margin-top: 10px;
  padding: 0 12px;
  border: 1px solid rgba(61, 130, 246, 0.3);
  border-radius: 11px;
  background: rgba(61, 130, 246, 0.1);
  color: var(--n-blue-soft);
  font-size: 9px;
  font-weight: 800;
  cursor: pointer;
}

.deposit-network {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.deposit-network-label {
  color: var(--n-muted);
  font-size: 9px;
}

.deposit-network-value {
  color: var(--n-lime);
  font-size: 9px;
  font-weight: 800;
}

.deposit-warning {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-top: 12px;
  padding: 11px;
  border: 1px solid rgba(255, 181, 71, 0.1);
  border-radius: 13px;
  background: rgba(255, 181, 71, 0.05);
  color: #dcb875;
  font-size: 9px;
  line-height: 1.45;
}

/* =========================================================
   LOADING
   ========================================================= */

.loading-screen {
  display: flex;
  min-height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  text-align: center;
}

.loading-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58px;
  height: 58px;
  margin-bottom: 16px;
  border-radius: 18px;
  background: linear-gradient(135deg, var(--n-blue), #5d96f4);
  color: #fff;
  font-size: 19px;
  font-weight: 900;
  box-shadow: 0 12px 35px rgba(61, 130, 246, 0.2);
}

.loading-spinner {
  width: 24px;
  height: 24px;
  margin-top: 18px;
  border: 2px solid rgba(255, 255, 255, 0.09);
  border-top-color: var(--n-blue);
  border-radius: 999px;
  animation: nexora-spin 0.8s linear infinite;
}

.loading-title {
  color: var(--n-text);
  font-size: 14px;
  font-weight: 780;
}

.loading-text {
  margin-top: 5px;
  color: var(--n-muted);
  font-size: 9px;
}

/* =========================================================
   TOAST
   ========================================================= */

.toast {
  position: fixed;
  z-index: 120;
  right: 12px;
  bottom: calc(82px + env(safe-area-inset-bottom));
  left: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.toast-inner {
  width: min(100%, 420px);
  padding: 11px 14px;
  border: 1px solid var(--n-border);
  border-radius: 13px;
  background: rgba(21, 27, 39, 0.96);
  color: var(--n-text);
  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.28);
  font-size: 10px;
  font-weight: 700;
  text-align: center;
  animation: nexora-toast-in 180ms ease-out;
}

.toast-inner.success {
  border-color: rgba(184, 245, 42, 0.2);
  color: var(--n-lime);
}

.toast-inner.error {
  border-color: rgba(255, 91, 91, 0.2);
  color: #ff8585;
}

.toast-inner.info {
  border-color: rgba(61, 130, 246, 0.22);
  color: var(--n-blue-soft);
}

/* =========================================================
   RESPONSIVE REFINEMENT
   ========================================================= */

@media (min-width: 560px) {
  .plan-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .plan-card {
    min-height: 180px;
  }

  .referral-stats-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .account-summary {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .modal-backdrop {
    align-items: center;
  }

  .modal {
    border-radius: 25px;
  }
}

@media (max-width: 380px) {
  .plan-grid {
    gap: 7px;
  }

  .plan-card {
    padding: 12px;
  }

  .plan-card-rate {
    font-size: 21px;
  }

  .earn-summary {
    gap: 6px;
  }

  .earn-summary-card {
    padding: 9px;
  }

  .bottom-nav-item {
    min-height: 48px;
  }

  .bottom-nav-label {
    font-size: 7px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .plan-card,
  .invest-confirm-button,
  .bottom-nav-item,
  .loading-spinner {
    transition: none;
    animation: none;
  }
}

/* =========================================================
   ANIMATIONS
   ========================================================= */

@keyframes nexora-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes nexora-modal-in {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes nexora-toast-in {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

