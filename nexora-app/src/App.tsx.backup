          INVITE &amp; EARN
        </div>

        <h3>Grow your network</h3>

        <p>
          Invite friends and unlock referral rewards as Nexora grows.
        </p>
      </motion.div>
    </motion.div>
  );
}

function InvestPage({
  plans,
  wallet,
  onCreated,
}: {
  plans: InvestmentPlan[];
  wallet: Wallet | null;
  onCreated: () => Promise<void>;
}) {
  const [selectedPlan, setSelectedPlan] =
    useState<InvestmentPlan | null>(null);

  const [amount, setAmount] = useState("");
  const [loading, setLoading] = useState(false);
  const [message, setMessage] = useState("");

  const numericAmount = Number(amount);

  const validAmount =
    Number.isFinite(numericAmount) &&
    numericAmount > 0 &&
    selectedPlan !== null &&
    numericAmount >= selectedPlan.min_amount &&
    (selectedPlan.max_amount === null ||
      numericAmount <= selectedPlan.max_amount);

  async function handleSubmit() {
    if (!selectedPlan || !validAmount) {
      return;
    }

    setLoading(true);
    setMessage("");

    try {
      await createInvestment(
        selectedPlan.id,
        numericAmount,
      );

      setMessage(
        "Investment created successfully.",
      );

      setAmount("");

      await onCreated();

      setTimeout(() => {
        setSelectedPlan(null);
        setMessage("");
      }, 1200);
    } catch (error) {
      setMessage(
        error instanceof Error
          ? error.message
          : "Unable to create investment.",
      );
    } finally {
      setLoading(false);
    }
  }

  return (
    <div className="page">
      <div className="page-heading">
        <span className="eyebrow">INVEST</span>
        <h1>Choose your plan</h1>
        <p>
          Select a plan that matches the amount
          you want to invest.
        </p>
      </div>

      <div className="available-card">
        <span>Available balance</span>
        <strong>
          {money(
            wallet?.available_balance ?? 0,
          )}
        </strong>
      </div>

      <div className="plans-list">
        {plans.map((plan, index) => (
          <motion.button
            key={plan.id}
            className={`plan-card ${
              index === 1 ? "featured" : ""
            }`}
            whileTap={{ scale: 0.985 }}
            onClick={() => {
              setSelectedPlan(plan);
              setAmount(
                String(plan.min_amount),
              );
              setMessage("");
            }}
          >
            <div className="plan-card-head">
              <div>
                <span className="plan-label">
                  {plan.name}
                </span>
                <h3>
                  {plan.return_rate}% return
                </h3>
              </div>

              <span className="plan-arrow">
                <Icon name="arrow" />
              </span>
            </div>

            <div className="plan-details">
              <span>
                {formatRange(plan)}
              </span>
              <span>
                {plan.duration_days} days
              </span>
              <span>{plan.currency}</span>
            </div>
          </motion.button>
        ))}
      </div>

      {selectedPlan ? (
        <div className="modal-backdrop">
          <motion.div
            className="modal-card"
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
          >
            <div className="modal-header">
              <div>
                <span className="eyebrow">
                  {selectedPlan.name}
                </span>
                <h2>
                  Start your investment
                </h2>
              </div>

              <button
                className="close-button"
                onClick={() =>
                  setSelectedPlan(null)
                }
              >
                ×
              </button>
            </div>

            <div className="modal-plan-summary">
              <div>
                <span>Return</span>
                <strong>
                  {selectedPlan.return_rate}%
                </strong>
              </div>

              <div>
                <span>Duration</span>
                <strong>
                  {selectedPlan.duration_days}d
                </strong>
              </div>

              <div>
                <span>Range</span>
                <strong>
                  {formatRange(selectedPlan)}
                </strong>
              </div>
            </div>

            <label className="field">
              <span>Investment amount</span>

              <div className="amount-input">
                <span>$</span>
                <input
                  inputMode="decimal"
                  value={amount}
                  onChange={(event) =>
                    setAmount(
                      event.target.value,
                    )
                  }
                  placeholder="0.00"
                />
              </div>
            </label>

            <p className="field-hint">
              Minimum{" "}
              {money(selectedPlan.min_amount)}
              {selectedPlan.max_amount !== null
                ? ` · Maximum ${money(
                    selectedPlan.max_amount,
                  )}`
                : ""}
            </p>

            {numericAmount > 0 &&
            Number.isFinite(numericAmount) ? (
              <div className="return-preview">
                <span>Expected return</span>
                <strong>
                  {money(
                    numericAmount +
                      (numericAmount *
                        selectedPlan.return_rate) /
                        100,
                  )}
                </strong>
              </div>
            ) : null}

            {message ? (
              <div
                className={`message ${
                  message.includes("successfully")
                    ? "success"
                    : "error"
                }`}
              >
                {message}
              </div>
            ) : null}

            <button
              className="primary-button"
              disabled={
                loading || !validAmount
              }
              onClick={handleSubmit}
            >
              {loading
                ? "Processing..."
                : "Confirm investment"}
            </button>

            <p className="demo-note">
              Demo mode only. No real funds are
              transferred.
            </p>
          </motion.div>
        </div>
      ) : null}
    </div>
  );
}

