import { useEffect, useMemo, useState } from "react";
import { motion } from "framer-motion";
import {
  authenticateTelegram,
  createInvestment,
  getInvestmentPlans,
  getWallet,
  getSessionToken,
} from "./lib/nexora-api";
import {
  getTelegramInitData,
  initTelegram,
} from "./lib/telegram";

type Page =
  | "home"
  | "invest"
  | "earn"
  | "friends"
  | "account";

type Wallet = {
  id: string;
  available_balance: number;
  locked_balance: number;
  currency: string;
};

type InvestmentPlan = {
  id: string;
  name: string;
  min_amount: number;
  max_amount: number | null;
  return_rate: number;
  duration_days: number;
  currency: string;
  is_active: boolean;
};

const fallbackPlans: InvestmentPlan[] = [
  {
    id: "starter",
    name: "Starter",
    min_amount: 10,
    max_amount: 99,
    return_rate: 1.2,
    duration_days: 30,
    currency: "USDT",
    is_active: true,
  },
  {
    id: "growth",
    name: "Growth",
    min_amount: 100,
    max_amount: 499,
    return_rate: 2.4,
    duration_days: 30,
    currency: "USDT",
    is_active: true,
  },
  {
    id: "pro",
    name: "Pro",
    min_amount: 500,
    max_amount: 1999,
    return_rate: 3.1,
    duration_days: 30,
    currency: "USDT",
    is_active: true,
  },
  {
    id: "elite",
    name: "Elite",
    min_amount: 2000,
    max_amount: null,
    return_rate: 4,
    duration_days: 30,
    currency: "USDT",
    is_active: true,
  },
];

function money(value: number) {
  return `$${value.toFixed(2)}`;
}

function formatRange(plan: InvestmentPlan) {
  if (plan.max_amount === null) {
    return `${money(plan.min_amount)}+`;
  }

  return `${money(plan.min_amount)}–${money(
    plan.max_amount,
  )}`;
}

function Icon({
  name,
}: {
  name:
    | "home"
    | "chart"
    | "gift"
    | "users"
    | "user"
    | "arrow"
    | "plus"
    | "lock"
    | "check";
}) {
  const paths: Record<string, string> = {
    home:
      "M3 10.5 12 3l9 7.5M5.5 9v11h13V9M9 20v-6h6v6",
    chart:
      "M4 19V5M4 19h16M8 16v-4M12 16V8M16 16V5",
    gift:
      "M3 8h18v13H3zM2 5h20v3H2zM12 5v16M12 5c-4 0-6-1-6-3 0-1.2 1-2 2.2-2C10.5 0 12 5 12 5Zm0 0c4 0 6-1 6-3 0-1.2-1-2-2.2-2C13.5 0 12 5 12 5Z",
    users:
      "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8-1a3 3 0 1 0-1-5.8M22 21v-2a4 4 0 0 0-3-3.9",
    user:
      "M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z",
    arrow:
      "M5 12h14M13 6l6 6-6 6",
    plus:
      "M12 5v14M5 12h14",
    lock:
      "M6 10V7a6 6 0 0 1 12 0v3M5 10h14v11H5z",
    check:
      "m5 12 4 4L19 6",
  };

  return (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth="1.8"
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden="true"
    >
      <path d={paths[name]} />
    </svg>
  );
}


function BalanceCard({
  wallet,
}: {
  wallet: Wallet | null;
}) {
  const available = wallet?.available_balance ?? 0;
  const locked = wallet?.locked_balance ?? 0;

  return (
    <motion.div
      className="balance-card"
      initial={{ opacity: 0, y: 12 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.35 }}
    >
      <div className="balance-card-top">
        <span>Total Balance</span>
        <span className="status-pill">
          <span className="status-dot" />
          Live
        </span>
      </div>

      <div className="balance-value">
        {money(available + locked)}
      </div>

      <div className="balance-meta">
        <div>
          <span>Available</span>
          <strong>{money(available)}</strong>
        </div>

        <div>
          <span>Invested</span>
          <strong>{money(locked)}</strong>
        </div>
      </div>
    </motion.div>
  );
}

function SectionTitle({
  title,
  action,
  onAction,
}: {
  title: string;
  action?: string;
  onAction?: () => void;
}) {
  return (
    <div className="section-title">
      <h2>{title}</h2>

      {action && onAction ? (
        <button
          className="text-button"
          onClick={onAction}
        >
          {action}
        </button>
      ) : null}
    </div>
  );
}

function HomePage({
  wallet,
  plans,
  onDeposit,
  onInvest,
}: {
  wallet: Wallet | null;
  plans: InvestmentPlan[];
  onDeposit: () => void;
  onInvest: () => void;
}) {
  const featuredPlan = plans[1] ?? plans[0];

  return (
    <motion.div
      className="page home-page"
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      transition={{ duration: 0.45 }}
    >
      <motion.div
        className="hero"
        initial={{ opacity: 0, y: 18 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.55 }}
      >
        <motion.div
          className="hero-orb"
          animate={{
            scale: [1, 1.08, 1],
            rotate: [0, 8, 0],
          }}
          transition={{
            duration: 5,
            repeat: Infinity,
            ease: "easeInOut",
          }}
        >
          <div className="hero-orb-core">N</div>
        </motion.div>

        <div className="hero-kicker">NEXORA</div>

        <h1>Grow Together</h1>

        <p>
          Build your portfolio with simple, transparent investment plans.
        </p>
      </motion.div>

      <motion.div
        initial={{ opacity: 0, y: 22 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ delay: 0.12, duration: 0.55 }}
      >
        <BalanceCard wallet={wallet} />
      </motion.div>

      <motion.div
        className="quick-actions"
        initial={{ opacity: 0, y: 18 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ delay: 0.22, duration: 0.5 }}
      >
        <button
