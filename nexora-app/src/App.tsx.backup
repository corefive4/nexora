function BottomNav({
  page,
  onChange,
}: {
  page: Page;
  onChange: (page: Page) => void;
}) {
  const items: {
    id: Page;
    label: string;
    icon:
      | "home"
      | "chart"
      | "gift"
      | "users"
      | "user";
  }[] = [
    {
      id: "home",
      label: "Home",
      icon: "home",
    },
    {
      id: "invest",
      label: "Invest",
      icon: "chart",
    },
    {
      id: "earn",
      label: "Earn",
      icon: "gift",
    },
    {
      id: "friends",
      label: "Friends",
      icon: "users",
    },
    {
      id: "account",
      label: "Account",
      icon: "user",
    },
  ];

  return (
    <nav className="bottom-nav">
      {items.map((item) => (
        <button
          key={item.id}
          className={
            page === item.id
              ? "nav-item active"
              : "nav-item"
          }
          onClick={() =>
            onChange(item.id)
          }
        >
          <span className="nav-icon">
            <Icon name={item.icon} />
          </span>
          <span>{item.label}</span>
        </button>
      ))}
    </nav>
  );
}


export default function App() {
  const [page, setPage] =
    useState<Page>("home");

  const [wallet, setWallet] =
    useState<Wallet | null>(null);

  const [plans, setPlans] =
    useState<InvestmentPlan[]>(
      fallbackPlans,
    );

  const [connected, setConnected] =
    useState(false);

  const [loading, setLoading] =
    useState(true);

  const [error, setError] =
    useState("");

  const [toast, setToast] =
    useState("");

  const webApp = useMemo(
    () => initTelegram(),
    [],
  );

  async function refreshWallet() {
    const current =
      await getWallet();

    setWallet(current);
  }

  useEffect(() => {
    let mounted = true;

    async function start() {
      try {
        setLoading(true);
        setError("");

        const initData =
          getTelegramInitData();

        if (!getSessionToken()) {
          if (!initData) {
            throw new Error(
              "Open Nexora from Telegram to continue.",
            );
          }

          await authenticateTelegram(
            initData,
          );
        }

        const [currentWallet, currentPlans] =
          await Promise.all([
            getWallet(),
            getInvestmentPlans(),
          ]);

        if (!mounted) {
          return;
        }

        setWallet(currentWallet);

        if (currentPlans.length > 0) {
          setPlans(currentPlans);
        }

        setConnected(true);
      } catch (err) {
        if (!mounted) {
          return;
        }

        setError(
          err instanceof Error
            ? err.message
            : "Unable to connect to Nexora.",
        );
      } finally {
        if (mounted) {
          setLoading(false);
        }
      }
    }

    void start();

    return () => {
      mounted = false;
    };
  }, []);

  function showDepositMessage() {
    setToast(
      "Deposit flow is coming next. Demo mode is active.",
    );

    window.setTimeout(() => {
      setToast("");
    }, 3000);
  }

  async function handleInvestmentCreated() {
    await refreshWallet();

    setToast(
      "Investment created successfully.",
    );

    window.setTimeout(() => {
      setToast("");
    }, 3000);
  }

  function renderPage() {
    if (page === "home") {
      return (
        <HomePage
          wallet={wallet}
          plans={plans}
          onInvest={() =>
            setPage("invest")
          }
          onDeposit={
            showDepositMessage
          }
        />
      );
    }

    if (page === "invest") {
      return (
        <InvestPage
          plans={plans}
          wallet={wallet}
          onCreated={
            handleInvestmentCreated
          }
        />
      );
    }

    if (page === "earn") {
      return <EarnPage />;
    }

    if (page === "friends") {
      return <FriendsPage />;
    }

    return (
      <AccountPage
        wallet={wallet}
        sessionReady={connected}
      />
    );
  }

  if (loading) {
    return (
      <div className="app-shell loading-screen">
        <div className="loading-logo">
          <span>N</span>
        </div>

        <h1>Nexora</h1>
        <p>Grow Together</p>

        <div className="loading-line">
          <span />
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="app-shell error-screen">
        <div className="error-card">
          <div className="error-logo">
            N
          </div>

          <span className="eyebrow">
            NEXORA
          </span>

          <h1>Connection required</h1>

          <p>{error}</p>

          <button
            className="primary-button"
            onClick={() =>
              window.location.reload()
            }
          >
            Try again
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="app-shell">
      <header className="topbar">
        <div className="brand">
          <div className="brand-mark">
            N
          </div>

          <div>
            <strong>Nexora</strong>
            <span>
              Grow Together
            </span>
          </div>
        </div>

        <div
          className={
            connected
              ? "connection-status"
              : "connection-status offline"
          }
        >
          <span />
          {connected
            ? "Connected"
            : "Offline"}
        </div>
      </header>

      <main>{renderPage()}</main>

      <BottomNav
        page={page}
        onChange={setPage}
      />

      {toast ? (
        <motion.div
          className="toast"
          initial={{
            opacity: 0,
            y: 20,
          }}
          animate={{
            opacity: 1,
            y: 0,
          }}
        >
          {toast}
        </motion.div>
      ) : null}

      {webApp ? null : (
        <div className="browser-note">
          Telegram Mini App mode
        </div>
      )}
    </div>
  );
}

