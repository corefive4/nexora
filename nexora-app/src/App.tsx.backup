          onClick={onDeposit}
        >
          <span>＋</span>
          Deposit
        </button>

        <button
          className="quick-action primary"
          onClick={onInvest}
        >
          <span>↗</span>
          Invest
        </button>
      </motion.div>

      <SectionTitle
        title="Featured Plan"
        action="View all"
        onAction={onInvest}
      />

      {featuredPlan && (
        <motion.button
          className="plan-card featured"
          onClick={onInvest}
          initial={{ opacity: 0, y: 18 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.32, duration: 0.55 }}
        >
          <div className="plan-card-top">
            <div>
              <div className="plan-name">
                {featuredPlan.name}
              </div>

              <div className="plan-range">
                {formatRange(featuredPlan)}
              </div>
            </div>

            <div className="plan-return">
              {Number(featuredPlan.return_rate).toFixed(1)}%
            </div>
          </div>

          <div className="plan-card-bottom">
            <span>
              {featuredPlan.duration_days} days
            </span>

            <span>Expected return</span>
          </div>
        </motion.button>
      )}

      <motion.div
        className="info-card"
        initial={{ opacity: 0, y: 18 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ delay: 0.42, duration: 0.5 }}
      >
        <div className="info-icon">✓</div>

        <div>
          <strong>Secure by design</strong>

          <p>
            Your account and investment actions are protected by Nexora's backend.
          </p>
