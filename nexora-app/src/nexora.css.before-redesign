:root {
  --nx-navy: #0D111A;
  --nx-secondary: #111722;
  --nx-card: #151B27;
  --nx-blue: #3D82F6;
  --nx-lime: #B8F52A;
  --nx-white: #F7F9FC;
  --nx-muted: #8B95A7;
  --nx-border: #222B3A;
  --nx-success: #35D07F;
  --nx-danger: #FF5C6C;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  min-height: 100%;
  margin: 0;
}

body {
  background: var(--nx-navy);
  color: var(--nx-white);
  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  -webkit-font-smoothing: antialiased;
}

button,
input {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

.nx-app {
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 90% 0%,
      rgba(61, 130, 246, 0.12),
      transparent 32%
    ),
    var(--nx-navy);
  padding-bottom: 86px;
}

.nx-content {
  width: 100%;
  max-width: 760px;
  margin: 0 auto;
  padding: 18px 16px 24px;
}

.nx-page {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.nx-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.nx-brand {
  display: flex;
  align-items: center;
  gap: 11px;
}

.nx-brand-mark,
.nx-loading-logo,
.nx-error-logo {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 13px;
  background:
    linear-gradient(
      135deg,
      var(--nx-blue),
      #2857c7
    );
  color: white;
  font-weight: 900;
  font-size: 20px;
  box-shadow:
    0 8px 24px rgba(61, 130, 246, 0.2);
}

.nx-brand-name {
  font-size: 17px;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.nx-brand-tagline {
  display: block;
  margin-top: 2px;
  color: var(--nx-muted);
  font-size: 11px;
}

.nx-header-action {
  width: 42px;
  height: 42px;
  border: 1px solid var(--nx-border);
  border-radius: 13px;
  background: var(--nx-card);
  color: var(--nx-white);
}

.nx-eyebrow {
  color: var(--nx-lime);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.nx-title {
  margin: 3px 0 0;
  font-size: 26px;
  line-height: 1.1;
  letter-spacing: -0.035em;
}

.nx-subtitle {
  margin: 6px 0 0;
  color: var(--nx-muted);
  font-size: 13px;
  line-height: 1.5;
}

.nx-balance-card {
  position: relative;
  overflow: hidden;
  padding: 21px;
  border: 1px solid rgba(61, 130, 246, 0.2);
  border-radius: 22px;
  background:
    linear-gradient(
      145deg,
      #182337 0%,
      var(--nx-card) 58%,
      #121925 100%
    );
}

.nx-balance-card::after {
  content: "";
  position: absolute;
  width: 150px;
  height: 150px;
  right: -70px;
  top: -70px;
  border-radius: 50%;
  background: rgba(61, 130, 246, 0.12);
}

.nx-balance-label {
  color: var(--nx-muted);
  font-size: 12px;
}

.nx-balance-value {
  margin-top: 7px;
  font-size: 31px;
  font-weight: 850;
  letter-spacing: -0.04em;
}

.nx-balance-currency {
  color: var(--nx-muted);
  font-size: 12px;
  font-weight: 600;
}

.nx-balance-grid {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 8px;
  margin-top: 22px;
}

.nx-mini-stat {
  padding-top: 13px;
  border-top: 1px solid var(--nx-border);
}

.nx-mini-stat-label {
  color: var(--nx-muted);
  font-size: 10px;
}

.nx-mini-stat-value {
  margin-top: 4px;
  font-size: 13px;
  font-weight: 750;
}

.nx-action-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.nx-primary-button,
.nx-secondary-button {
  min-height: 48px;
  border-radius: 14px;
  border: 1px solid transparent;
  padding: 0 16px;
  font-weight: 750;
  cursor: pointer;
}

.nx-primary-button {
  background: var(--nx-blue);
  color: white;
}

.nx-secondary-button {
  border-color: var(--nx-border);
  background: var(--nx-card);
  color: var(--nx-white);
}

.nx-primary-button:active,
.nx-secondary-button:active,
.nx-header-action:active,
.nx-nav-item:active {
  transform: scale(0.98);
}

.nx-full-button {
  width: 100%;
}

.nx-section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.nx-section-title h2 {
  margin: 0;
  font-size: 16px;
  letter-spacing: -0.02em;
}

.nx-section-title span {
  color: var(--nx-muted);
  font-size: 11px;
}

.nx-card {
  border: 1px solid var(--nx-border);
  border-radius: 18px;
  background: var(--nx-card);
}

.nx-plan-card {
  position: relative;
  overflow: hidden;
  padding: 18px;
}

.nx-plan-card.nx-plan-featured {
  border-color: rgba(184, 245, 42, 0.28);
}

.nx-plan-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.nx-plan-name {
  margin: 0;
  font-size: 17px;
  font-weight: 800;
}

.nx-plan-range {
  margin-top: 5px;
  color: var(--nx-muted);
  font-size: 11px;
}

.nx-rate {
  color: var(--nx-lime);
  font-size: 20px;
  font-weight: 850;
}

.nx-rate small {
  display: block;
  color: var(--nx-muted);
  font-size: 9px;
  font-weight: 600;
  text-align: right;
}

.nx-badge {
  display: inline-flex;
  align-items: center;
  padding: 5px 8px;
  border-radius: 7px;
  background: rgba(184, 245, 42, 0.1);
  color: var(--nx-lime);
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.06em;
}

.nx-plan-meta {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 16px;
}

.nx-meta-pill {
  padding: 7px 9px;
  border-radius: 9px;
  background: var(--nx-secondary);
  color: var(--nx-muted);
  font-size: 10px;
}

.nx-meta-pill strong {
  color: var(--nx-white);
}

.nx-list {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.nx-list-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
  border: 1px solid var(--nx-border);
  border-radius: 15px;
  background: var(--nx-card);
}

.nx-list-icon {
  display: grid;
  place-items: center;
  flex: 0 0 40px;
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: var(--nx-secondary);
  color: var(--nx-blue);
}

.nx-list-main {
  min-width: 0;
  flex: 1;
}

.nx-list-title {
  font-size: 13px;
  font-weight: 750;
}

.nx-list-description {
  margin-top: 3px;
  color: var(--nx-muted);
  font-size: 10px;
}

.nx-list-value {
  text-align: right;
  font-size: 12px;
  font-weight: 800;
}

.nx-positive {
  color: var(--nx-success);
}

.nx-muted {
  color: var(--nx-muted);
}
.nx-bottom-nav {
  position: fixed;
  left: 50%;
  bottom: 0;
  z-index: 40;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  width: min(100%, 760px);
  transform: translateX(-50%);
  padding: 8px 8px calc(8px + env(safe-area-inset-bottom));
  border-top: 1px solid var(--nx-border);
  background: rgba(13, 17, 26, 0.96);
  backdrop-filter: blur(18px);
}

.nx-nav-item {
  display: flex;
  min-width: 0;
  min-height: 56px;
  align-items: center;
  justify-content: center;
  gap: 4px;
  flex-direction: column;
  border: 0;
  background: transparent;
  color: var(--nx-muted);
  font-size: 9px;
  font-weight: 650;
  cursor: pointer;
}

.nx-nav-icon {
  display: grid;
  place-items: center;
  width: 34px;
  height: 28px;
  border-radius: 9px;
}

.nx-nav-active {
  color: var(--nx-white);
}

.nx-nav-active .nx-nav-icon {
  background: rgba(61, 130, 246, 0.14);
  color: var(--nx-blue);
}

.nx-empty {
  padding: 25px 16px;
  border: 1px dashed var(--nx-border);
  border-radius: 17px;
  background: rgba(21, 27, 39, 0.5);
  text-align: center;
}

.nx-empty-icon {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  margin: 0 auto 10px;
  border-radius: 14px;
  background: var(--nx-secondary);
  color: var(--nx-muted);
}

.nx-empty-title {
  font-size: 13px;
  font-weight: 750;
}

.nx-empty-text {
  max-width: 300px;
  margin: 5px auto 0;
  color: var(--nx-muted);
  font-size: 11px;
  line-height: 1.5;
}

.nx-invest-detail {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.nx-back-button {
  align-self: flex-start;
  border: 0;
  background: transparent;
  color: var(--nx-muted);
  padding: 5px 0;
  font-size: 12px;
}

.nx-amount-box {
  padding: 18px;
  border: 1px solid var(--nx-border);
  border-radius: 18px;
  background: var(--nx-card);
}

.nx-input-label {
  display: block;
  margin-bottom: 8px;
  color: var(--nx-muted);
  font-size: 11px;
}

.nx-amount-input {
  width: 100%;
  min-height: 52px;
  padding: 0 14px;
  border: 1px solid var(--nx-border);
  border-radius: 13px;
  outline: none;
  background: var(--nx-secondary);
  color: var(--nx-white);
  font-size: 19px;
  font-weight: 800;
}

.nx-amount-input:focus {
  border-color: var(--nx-blue);
}

.nx-calculation {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 9px;
}

.nx-calc-item {
  padding: 13px;
  border-radius: 13px;
  background: var(--nx-secondary);
}

.nx-calc-label {
  color: var(--nx-muted);
  font-size: 9px;
}

.nx-calc-value {
  margin-top: 4px;
  font-size: 13px;
  font-weight: 800;
}

.nx-hero {
  padding: 22px;
  border: 1px solid rgba(61, 130, 246, 0.2);
  border-radius: 21px;
  background:
    linear-gradient(
      145deg,
      rgba(61, 130, 246, 0.14),
      var(--nx-card)
    );
}

.nx-hero h1 {
  margin: 5px 0 0;
  font-size: 25px;
  line-height: 1.12;
  letter-spacing: -0.035em;
}

.nx-hero p {
  margin: 9px 0 0;
  color: var(--nx-muted);
  font-size: 12px;
  line-height: 1.55;
}

.nx-referral-link {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 16px;
  padding: 10px;
  border-radius: 12px;
  background: var(--nx-secondary);
}

.nx-referral-link code {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: var(--nx-muted);
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nx-copy-button {
  flex: 0 0 auto;
  border: 0;
  border-radius: 9px;
  padding: 8px 10px;
  background: var(--nx-blue);
  color: white;
  font-size: 10px;
  font-weight: 750;
}

.nx-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
}

.nx-stat-card {
  padding: 14px;
  border: 1px solid var(--nx-border);
  border-radius: 15px;
  background: var(--nx-card);
}

.nx-stat-card-label {
  color: var(--nx-muted);
  font-size: 9px;
}

.nx-stat-card-value {
  margin-top: 5px;
  font-size: 15px;
  font-weight: 850;
}

.nx-level-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
  border: 1px solid var(--nx-border);
  border-radius: 15px;
  background: var(--nx-card);
}

.nx-level-number {
  display: grid;
  place-items: center;
  flex: 0 0 38px;
  width: 38px;
  height: 38px;
  border-radius: 11px;
  background: var(--nx-secondary);
  color: var(--nx-lime);
  font-weight: 850;
}

.nx-level-main {
  flex: 1;
}

.nx-level-title {
  font-size: 12px;
  font-weight: 750;
}

.nx-level-text {
  margin-top: 3px;
  color: var(--nx-muted);
  font-size: 10px;
}

.nx-profile {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 17px;
  border: 1px solid var(--nx-border);
  border-radius: 18px;
  background: var(--nx-card);
}

.nx-avatar {
  display: grid;
  place-items: center;
  flex: 0 0 52px;
  width: 52px;
  height: 52px;
  border-radius: 16px;
  background: linear-gradient(
    135deg,
    var(--nx-blue),
    #2347a9
  );
  font-size: 19px;
  font-weight: 850;
}

.nx-profile-main {
  min-width: 0;
  flex: 1;
}

.nx-profile-name {
  font-size: 15px;
  font-weight: 800;
}

.nx-profile-id {
  margin-top: 3px;
  color: var(--nx-muted);
  font-size: 10px;
}

.nx-menu {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--nx-border);
  border-radius: 18px;
  background: var(--nx-card);
}

.nx-menu-item {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 58px;
  padding: 9px 14px;
  border: 0;
  border-bottom: 1px solid var(--nx-border);
  background: transparent;
  color: var(--nx-white);
  text-align: left;
}

.nx-menu-item:last-child {
  border-bottom: 0;
}

.nx-menu-icon {
  display: grid;
  place-items: center;
  flex: 0 0 38px;
  width: 38px;
  height: 38px;
  border-radius: 11px;
  background: var(--nx-secondary);
  color: var(--nx-blue);
}

.nx-menu-text {
  min-width: 0;
  flex: 1;
}

.nx-menu-title {
  font-size: 12px;
  font-weight: 750;
}

.nx-menu-description {
  margin-top: 2px;
  color: var(--nx-muted);
  font-size: 9px;
}

.nx-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 12px;
  background: rgba(0, 0, 0, 0.65);
}

.nx-modal {
  width: min(100%, 560px);
  max-height: 88vh;
  overflow-y: auto;
  padding: 10px 18px 20px;
  border: 1px solid var(--nx-border);
  border-radius: 23px 23px 16px 16px;
  background: var(--nx-card);
}

.nx-modal-handle {
  width: 42px;
  height: 4px;
  margin: 0 auto 18px;
  border-radius: 99px;
  background: var(--nx-border);
}

.nx-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.nx-modal-header span {
  color: var(--nx-lime);
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.12em;
}

.nx-modal-header h2 {
  margin: 4px 0 0;
  font-size: 20px;
}

.nx-close-button {
  width: 38px;
  height: 38px;
  border: 0;
  border-radius: 11px;
  background: var(--nx-secondary);
  color: var(--nx-muted);
  font-size: 22px;
}

.nx-network-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-top: 16px;
  padding: 7px 10px;
  border-radius: 99px;
  background: rgba(53, 208, 127, 0.09);
  color: var(--nx-success);
  font-size: 10px;
  font-weight: 750;
}

.nx-network-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--nx-success);
}

.nx-modal-text {
  color: var(--nx-muted);
  font-size: 11px;
  line-height: 1.55;
}

.nx-address-box {
  overflow-wrap: anywhere;
  padding: 14px;
  border: 1px solid var(--nx-border);
  border-radius: 13px;
  background: var(--nx-secondary);
}

.nx-address-box code {
  color: var(--nx-white);
  font-size: 10px;
  line-height: 1.5;
}

.nx-warning {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin: 12px 0 16px;
  padding: 12px;
  border-radius: 13px;
  background: rgba(255, 92, 108, 0.07);
  color: var(--nx-muted);
  font-size: 9px;
  line-height: 1.5;
}

.nx-warning strong {
  color: var(--nx-danger);
  font-size: 10px;
}

.nx-toast {
  position: fixed;
  left: 50%;
  bottom: 94px;
  z-index: 100;
  width: min(calc(100% - 32px), 500px);
  transform: translateX(-50%);
  padding: 12px 14px;
  border: 1px solid var(--nx-border);
  border-radius: 13px;
  background: var(--nx-card);
  color: var(--nx-white);
  text-align: center;
  font-size: 11px;
  font-weight: 700;
}

.nx-toast-success {
  border-color: rgba(53, 208, 127, 0.35);
}

.nx-toast-error {
  border-color: rgba(255, 92, 108, 0.35);
}

.nx-loading,
.nx-error-screen {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 30px;
  background: var(--nx-navy);
  text-align: center;
}

.nx-loading-logo,
.nx-error-logo {
  width: 58px;
  height: 58px;
  margin-bottom: 8px;
  border-radius: 18px;
  font-size: 26px;
}

.nx-loading strong {
  font-size: 19px;
}

.nx-loading span {
  color: var(--nx-muted);
  font-size: 11px;
}

.nx-loading-bar {
  width: 130px;
  height: 3px;
  margin-top: 16px;
  overflow: hidden;
  border-radius: 99px;
  background: var(--nx-border);
}

.nx-loading-bar i {
  display: block;
  width: 45%;
  height: 100%;
  border-radius: inherit;
  background: var(--nx-blue);
  animation: nx-loading 1.1s ease-in-out infinite;
}

.nx-error-screen h1 {
  margin: 0;
  font-size: 21px;
}

.nx-error-screen p {
  max-width: 360px;
  color: var(--nx-muted);
  font-size: 12px;
  line-height: 1.5;
}

@keyframes nx-loading {
  0% {
    transform: translateX(-120%);
  }
  100% {
    transform: translateX(300%);
  }
}

@media (max-width: 390px) {
  .nx-content {
    padding-left: 12px;
    padding-right: 12px;
  }

  .nx-balance-value {
    font-size: 27px;
  }

  .nx-title {
    font-size: 23px;
  }

  .nx-stats-grid {
    gap: 6px;
  }

  .nx-stat-card {
    padding: 11px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .nx-loading-bar i {
    animation: none;
  }

  .nx-primary-button:active,
  .nx-secondary-button:active,
  .nx-header-action:active,
  .nx-nav-item:active {
    transform: none;
  }
}
